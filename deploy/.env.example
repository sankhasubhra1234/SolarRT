# Copy to .env on the server and fill in. Never commit .env.

# Web address of the server. Without a domain, use your VPS IP with dashes + .sslip.io,
# e.g. IP 203.0.113.5  ->  203-0-113-5.sslip.io   (free; HTTPS works automatically)
SOLARRT_DOMAIN=203-0-113-5.sslip.io

# Must match SOLARRT_DOMAIN (comma-separate extra names, e.g. www.yourdomain.com)
SOLARRT_ALLOWED_HOSTS=203-0-113-5.sslip.io

# Secret for reading feedback: GET /api/feedback with header "Authorization: Bearer <token>".
# Generate one with:  openssl rand -hex 32
SOLARRT_ADMIN_TOKEN=

# Interactive API docs at /docs (0 = off, recommended in production)
SOLARRT_ENABLE_DOCS=0

# Optional tuning (per client, per minute)
# SOLARRT_RATE_LIMIT_API=240
# SOLARRT_RATE_LIMIT_SEARCH=20
