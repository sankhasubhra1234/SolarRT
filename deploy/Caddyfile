# Caddy: gets and renews a free HTTPS certificate (Let's Encrypt) for SOLARRT_DOMAIN automatically,
# redirects http -> https and forwards requests to the SolarRT app container.
# No access log is configured on purpose: request URLs contain users' coordinates.

{$SOLARRT_DOMAIN} {
	encode zstd gzip

	header {
		# Force HTTPS for a year once a browser has visited (enable "; preload" only when sure)
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	request_body {
		max_size 64KB
	}

	reverse_proxy app:8000 {
		health_uri /api/health
		health_headers {
			Host {$SOLARRT_DOMAIN}
		}
	}
}
